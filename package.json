{
  "name": "serverless-fixity-for-digital-preservation-compliance",
  "version": "2.0.0",
  "description": "Compute and verify MD5, SHA-1 and SHA-256 checksums for S3 objects of any size, including objects archived in Glacier.",
  "type": "module",
  "private": true,
  "license": "MIT-0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pretest": "test -d src/node_modules || npm --prefix src ci --no-audit --no-fund",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "validate": "sam validate --lint",
    "build": "sam build",
    "deploy": "sam deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
